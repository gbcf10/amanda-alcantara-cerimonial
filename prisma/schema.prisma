generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL da Hostinger (Business Web Hosting inclui MySQL ilimitado).
  // A DATABASE_URL vai no .env no formato:
  // mysql://usuario:senha@localhost:3306/nome_do_banco
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  eventType  String? // ex: "Casamento", "Debutante", "Batizado"
  quote      String   @db.Text
  rating     Int      @default(5)
  photoUrl   String?  @db.Text
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.Text
  photoUrl  String?  @db.Text
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  category  String? // ex: "Fotografia", "Buffet", "Decoração"
  logoUrl   String?  @db.Text
  website   String?  @db.Text
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  caption   String?
  category  String? // ex: "Casamento", "Debutante"
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// status: "available" | "unavailable" | "booked"
model AvailabilityDate {
  id     String   @id @default(cuid())
  date   DateTime @unique
  status String
  note   String?
}

// status: "novo" | "contatado" | "fechado" | "recusado"
model QuoteRequest {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String
  eventType   String
  eventDate   DateTime?
  location    String?
  guestCount  String?
  partnerName String?
  message     String?   @db.Text
  status      String    @default("novo")
  createdAt   DateTime  @default(now())
}

model SiteSettings {
  id             Int     @id @default(1)
  heroTitle      String
  heroSubtitle   String  @db.Text
  aboutText      String  @db.Text
  instagramUrl   String?
  whatsappNumber String?
  email          String?
}

// ---- Comunidade das noivas ----

model BrideUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?  @db.Text
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  posts     Post[]
  comments  Comment[]
  reactions Reaction[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    BrideUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  imageUrl  String?  @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  comments  Comment[]
  reactions Reaction[]

  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    BrideUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

// type: "amei" | "parabens" | "fofo" | "bravo"
model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    BrideUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@unique([postId, authorId])
  @@index([authorId])
}

// ---- Book de casais ----

model Couple {
  id          String    @id @default(cuid())
  names       String // ex: "Ana & João"
  slug        String    @unique
  weddingDate DateTime?
  coverUrl    String?   @db.Text
  story       String?   @db.Text
  published   Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  media CoupleMedia[]
}

// ---- Bastidores ----

// type: "photo" | "video" (video = link do YouTube/Vimeo ou URL de arquivo de vídeo)
model BackstageMedia {
  id        String   @id @default(cuid())
  type      String
  url       String   @db.Text
  caption   String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// type: "photo" | "video" (video = link do YouTube/Vimeo ou URL de arquivo de vídeo)
model CoupleMedia {
  id       String  @id @default(cuid())
  coupleId String
  couple   Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  type     String
  url      String  @db.Text
  caption  String?
  order    Int     @default(0)

  @@index([coupleId])
}
