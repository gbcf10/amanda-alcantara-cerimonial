# Copie este arquivo para .env e preencha os valores.
# Em produção (Hostinger), essas variáveis vão em hPanel > Node.js > Environment variables.

# Banco de dados MySQL da Hostinger.
# Crie em hPanel > Bancos de dados > MySQL, e cole a connection string aqui.
# Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
# Na Hostinger o HOST geralmente é "localhost".
DATABASE_URL="mysql://usuario:senha@localhost:3306/nome_do_banco"

# Login do painel admin.
ADMIN_EMAIL="voce@exemplo.com"

# Hash da senha em base64. Gere com:  npm run hash-password -- "sua-senha"
# (o base64 é necessário porque o carregador de env do Next quebra os `$` do hash bcrypt)
ADMIN_PASSWORD_HASH_B64=""

# Segredo pra assinar sessões JWT (mínimo 32 caracteres aleatórios).
# Gere com:  openssl rand -base64 48
SESSION_SECRET=""

# URL pública do site (com https://).
NEXT_PUBLIC_SITE_URL="https://seudominio.com"
